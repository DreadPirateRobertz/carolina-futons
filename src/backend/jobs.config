/**
 * Wix Jobs Scheduler configuration.
 * Defines recurring backend jobs for email automation and social story scheduling.
 *
 * @see https://dev.wix.com/docs/develop-websites/articles/coding-with-velo/backend-code/jobs-scheduler/scheduling-recurring-jobs
 */

// @ts-check

/** @type {import('wix-jobs').JobsConfig} */
export function config() {
  return {
    // Process pending emails in the queue every 15 minutes
    processEmailQueue: {
      functionLocation: '/emailAutomation.web.js',
      description: 'Process pending emails from the EmailQueue CMS collection',
      executionConfig: {
        cronExpression: '*/15 * * * *',
      },
    },

    // Check for abandoned carts and queue recovery emails every hour
    triggerAbandonedCartRecovery: {
      functionLocation: '/emailAutomation.web.js',
      description: 'Find abandoned carts >1hr old and queue recovery email sequences',
      executionConfig: {
        cronExpression: '0 * * * *',
      },
    },

    // Re-engage inactive members every Monday at 9 AM EST
    triggerReengagement: {
      functionLocation: '/emailAutomation.web.js',
      description: 'Target contacts inactive >90 days with re-engagement offer',
      executionConfig: {
        cronExpression: '0 14 * * 1', // 14:00 UTC = 9 AM EST
      },
    },

    // Check for browse abandonment sessions every 2 hours and queue recovery emails
    checkBrowseAbandonment: {
      functionLocation: '/browseAbandonment.web.js',
      description: 'Find high-intent browse sessions older than 2h and queue recovery emails',
      executionConfig: {
        cronExpression: '0 */2 * * *',
      },
    },

    // Schedule daily social stories for new arrivals and price drops at 10 AM MT
    dailySocialStories: {
      functionLocation: '/socialStoryScheduler.web.js',
      description: 'Query catalog for new arrivals + price drops and schedule social stories across Instagram, Facebook, Pinterest',
      executionConfig: {
        cronExpression: '0 17 * * *', // 17:00 UTC = 10 AM MST / 11 AM MDT
      },
    },

    // Day-of-week content rotation: featured product / review highlight / tip / promo (CF-a174)
    dailyContentRotation: {
      functionLocation: '/socialStoryScheduler.web.js',
      description: 'Mon/Wed/Fri: featured product; Tue/Thu: review highlight; Sat: furniture tip; Sun: weekend promo',
      executionConfig: {
        cronExpression: '5 17 * * *', // 17:05 UTC = 10:05 AM MST / 11:05 AM MDT (staggered from dailySocialStories)
      },
    },

    // Refresh Facebook/Meta product catalog every 6 hours
    refreshFacebookCatalog: {
      functionLocation: '/facebookCatalog.web.js',
      description: 'Validate all products against Meta Commerce catalog rules; alert owner on failures',
      executionConfig: {
        cronExpression: '0 */6 * * *',
      },
    },

    // Daily wishlist price-drop check at 8 AM EST
    checkWishlistPriceDrops: {
      functionLocation: '/wishlistAlerts.web.js',
      description: 'Compare current prices to 30-day high for all wishlisted products; email members on >=10% drop',
      executionConfig: {
        cronExpression: '0 13 * * *', // 13:00 UTC = 8 AM EST
      },
    },

    // Daily back-in-stock check at 8:05 AM EST (staggered from price-drop job)
    checkWishlistBackInStock: {
      functionLocation: '/wishlistAlerts.web.js',
      description: 'Find wishlisted out-of-stock products now available; email members on restock',
      executionConfig: {
        cronExpression: '5 13 * * *', // 13:05 UTC = 8:05 AM EST
      },
    },

    // CF-tcqq: Day 7 streak milestone notifications at 10 AM EST
    checkStreakMilestoneNotifications: {
      functionLocation: '/gamificationNotifs.web.js',
      description: 'Send day-7 streak milestone emails to opted-in members',
      executionConfig: {
        cronExpression: '0 15 * * *', // 15:00 UTC = 10 AM EST
      },
    },

    // Sync Wix Stores inventory into InventoryThresholds every 30 minutes
    // Drives Low Stock badges on product cards and PDP urgency banners
    syncInventoryFromStore: {
      functionLocation: '/inventorySync.web.js',
      description: 'Read Wix Stores product stock levels and upsert InventoryThresholds CMS; raise LowStockAlerts when products cross below reorder threshold',
      executionConfig: {
        cronExpression: '*/30 * * * *',
      },
    },

    // cf-zubx: Detect product price drops daily and queue mobile push notifications
    // Inserts PriceDropQueue entries (>=5% drop vs last recorded price).
    // Also sends in-app loyalty notifications to members who wishlisted the item.
    detectPriceDrops: {
      functionLocation: '/priceDropCron.web.js',
      description: 'Scan Stores/Products for price drops vs ProductPriceHistory; queue PriceDropQueue entries for mobile and notify wishlisted members',
      executionConfig: {
        cronExpression: '0 13 * * *', // 13:00 UTC = 8 AM EST (after daily price updates)
      },
    },

    // cf-u30i: Weekly analytics digest email to Brenda Deal every Monday at 8 AM MT
    // Aggregates AnalyticsEvents, funnel metrics, loyalty stats, and referral stats
    // into a mobile-readable email queued via EmailQueue collection.
    sendWeeklyDigestEmail: {
      functionLocation: '/analyticsDigest.web.js',
      description: 'Build and queue weekly analytics digest email for carolinafutons@gmail.com',
      executionConfig: {
        cronExpression: '0 15 * * 1', // 15:00 UTC = 8 AM MT (Monday)
      },
    },

    // CF-3izl.1: Daily purchase-anniversary milestone scanner at 9 AM UTC
    scanLifecycleMilestones: {
      functionLocation: '/lifecycleCron.web.js',
      description: 'Scan all orders for Day 7, Month 1, and Year 1 anniversary milestones; return qualifying orders for downstream lifecycle communications',
      executionConfig: {
        cronExpression: '0 9 * * *',
      },
    },

    // CF-3izl.3: Queue lifecycle emails at 9:05 AM UTC (5 min after scan)
    sendLifecycleEmails: {
      functionLocation: '/lifecycleEmailSender.web.js',
      description: 'Queue Day 7 care guide, Month 1 check-in, and Year 1 anniversary emails for milestone orders; deduped via SentLifecycleMails',
      executionConfig: {
        cronExpression: '5 9 * * *',
      },
    },

    // CF-rjxq: Send 48-hour reminder SMS to white-glove appointments 2 days out
    sendWhiteGlove48hReminders: {
      functionLocation: '/whiteGloveScheduling.web.js',
      description: 'SMS 48h reminders for white-glove appointments 2 days from now; deduped via SMSLog',
      executionConfig: {
        cronExpression: '0 13 * * *',
      },
    },

    // CF-rjxq: Send day-of SMS to white-glove appointments scheduled for today
    sendWhiteGloveDayOfReminders: {
      functionLocation: '/whiteGloveScheduling.web.js',
      description: 'Day-of SMS reminders for white-glove appointments today; deduped via SMSLog',
      executionConfig: {
        cronExpression: '0 13 * * *',
      },
    },

    // cf-0jk5: Daily A/B experiment significance check — auto-stops experiments at p<0.05
    autoStopSignificantExperiments: {
      functionLocation: '/abTestDashboard.web.js',
      description: 'Auto-stop A/B experiments that have reached statistical significance (p<0.05)',
      executionConfig: {
        cronExpression: '0 14 * * *',
      },
    },
  };
}
